$define _GNU_SOURCE

$include <stdio.h>
$include <string.h>
$include <dlfcn.h>
$include <jni.h>

$include <memory_map.h>
$include <pkru_sandbox.h>
$include <domain_manager.h>
$include <hash_table.h>

$include "$headerFilename"

$returnType (*_native_method)($paramTypes); // accessible in default domain only

void *get_handle(IsolateFunction *function) {
    printf("enter get handle\n");
    static char *error;

#ifdef REMOVE_NNS_LIMIT
    int domain = function->current_domain;
    IsolateFunction *primary_function = get_primary_pkru_sandbox(domain);
    printf("primary function: %p\n", primary_function);
    if (primary_function) {
        return primary_function->dl_handle;
    }
#endif

    if (function->dl_handle == NULL) {
        dlerror();
        function->dl_handle = dlmopen(LM_ID_NEWLM, "$nativeLibName", RTLD_LAZY);
        if ((error = dlerror()) != NULL) {
            fprintf(stdout, "Could not load library: $nativeLibName: %s\n", error);
            return NULL;   
        }
    }

#ifdef REMOVE_NNS_LIMIT
    set_primary_pkru_sandbox(domain, function);
#endif

    return function->dl_handle;
}

int load_native_method(IsolateFunction *function) {
    printf("enter load native method\n");
    static char *error;
    void *dl_handle;
    
    if ((dl_handle = get_handle(function)) == NULL)
        return -1;

    printf("dl_handle: %p\n", dl_handle);

    dlerror();
    _native_method = dlsym(dl_handle, "$nativeMethod");    
    if ((error = dlerror()) != NULL) {
        fprintf(stdout, "Failed to find the symbol: $nativeMethod: %s\n", error);
        return -1;
    }

    return 0;
}

void nativeMethodInterface(int pkey) {
    printf("enter native method interface\n");
    IsolateFunction *function = get_pkru_sandbox(pkey);
    if (load_native_method(function))
        exit(EXIT_FAILURE);

    printf("global native method symbol: %p\n", _native_method);

    request_t* request = (request_t*) get_domain_arena(pkey);
    $returnType (*native_method)($paramTypes) = _native_method; // accessible in worker domain

    __wrpkrumem(DOMAIN_TO_PKRU(pkey) & DOMAIN_TO_PKRU(LOADER_DOMAIN));
    native_method($args);
    __wrpkru(DEFAULT_DOMAIN);

    // TODO: implement correct return value
}

/*
 * The domain arena is setup in the following way:
 * |---  request (sizeof(request_t bytes) long) ---|
 * |---      args[0] (arg_size bytes long)      ---|
 * |---      args[1] (arg_size bytes long)      ---|
 * |---      args[N] (arg_size bytes long)      ---|
 * |---        ret (ret_size bytes long)        ---|
 *
 */
JNIEXPORT $returnType JNICALL $callGate($params) {
    SNI_DBM("[s]: Getting available domain...");

    print_systime();

    int domain;
    request_t * request;
    IsolateFunction *function;
    [[maybe_unused]] size_t size;
    [[maybe_unused]] void *aux;

    function = get_cached_pkru_sandbox();
    if (!function) {
        function = (IsolateFunction *)hash_table_lookup(proc_tbl, gettid());
        set_cached_pkru_sandbox(function);
    }
    
    domain = enter_sandbox_domain(function);

    // Acquire worker lock
    pthread_mutex_t* request_lock = get_request_lock(domain); 
    pthread_mutex_lock(request_lock);

    request = (request_t*) get_domain_arena(domain);
    request->fun = nativeMethodInterface;
    aux = (void *)((char *)request + sizeof(request_t));

    // Copying the function call argument to arena.
#if( $numArgs > 0 )
#foreach( $_ in [1..$numArgs] )
#set( $idx = $foreach.index )

    // copy arg$idx
    request->args[$idx] = aux;
#if( $jniTypes[$idx] != "jstring" )
    size = $argSizes[$idx];
    request->arg_sizes[$idx] = size;
    memcpy(request->args[$idx], &arg$idx, size);
#else
    size = (*env)->GetStringLength(env, arg$idx) * sizeof(short);
    memcpy(request->args[$idx], (*env)->GetStringChars(env, arg$idx, NULL), size);
    printf("string size: %ld, content: ", size);
    for (int i = 0; i < size; i++) {
        printf("%c", *((char *)request->args[$idx] + i));
    }
    printf("\n");
    fflush(stdout);
#end
    aux = (void *)((char *)aux + size);
#end
#end

    // TODO: copy arguments
    request->env = env;
    request->obj = obj;

    notify_worker(domain);
    wait_worker(domain);
    // fprintf(stderr, "User thread notify\n");
   
    // Copying return value to arena and setting ret and ret_size pointers.
    // __attribute__((unused)) void *ret = (void*) (((char*) request->arg) + arg_size);
    // *ret_size = request->ret_size; // TODO
    // memcpy(*ret, request->ret, request->ret_size); // TODO
	// return ret; // TODO: implement correct return value
    pthread_mutex_unlock(request_lock);

    leave_sandbox_domain(function);

    print_systime();

    return;
}
